# ==============================================================================
# AGROTECH VENEZUELA 🌾🛰️ — CONFIGURACIÓN DE PRODUCCIÓN (VPS / CLOUD / DOCKER)
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo a `.env` en tu servidor de producción:
#    cp .env.production.example .env
# 2. Reemplaza los valores de ejemplo por tus credenciales y secretos reales.
# 3. NUNCA comitees el archivo `.env` resultante al repositorio Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS RELACIONAL POSTGRESQL 15
# ------------------------------------------------------------------------------
# En entornos Docker VPS, el host interno es 'agrotech-db' (puerto 5432).
# Si utilizas Supabase, Neon o RDS, coloca la cadena de conexión provista.
POSTGRES_USER=agrotech_prod_admin
POSTGRES_PASSWORD=genera_una_clave_aleatoria_fuerte_de_al_menos_32_caracteres
POSTGRES_DB=agrotech_venezuela_prod

# Para Docker Compose en VPS:
DATABASE_URL="postgresql://agrotech_prod_admin:${POSTGRES_PASSWORD}@agrotech-db:5432/agrotech_venezuela_prod?schema=public"

# Para conexión externa o despliegue en Vercel/Render conectado a Supabase/Neon:
# DATABASE_URL="postgresql://user:pass@ep-cool-db.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. SEGURIDAD, SESIONES & AUTENTICACIÓN JWT
# ------------------------------------------------------------------------------
# Genera un secreto criptográfico de 32 bytes ejecutando en terminal:
# Linux/Mac/Git Bash: openssl rand -hex 32
# PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
NEXTAUTH_SECRET=coloca_aqui_tu_token_criptografico_de_32_bytes_para_jwt
NEXTAUTH_URL=https://agrotech.ve

# Dominio público para CORS y redirecciones seguras
NEXT_PUBLIC_APP_URL=https://agrotech.ve

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI (PRODUCCIÓN)
# ------------------------------------------------------------------------------
# Credencial de la API de Google Gemini para el asistente agronómico territorial:
GEMINI_API_KEY=AIzaSyTuClaveProduccionDeGoogleGemini
GOOGLE_API_KEY=AIzaSyTuClaveProduccionDeGoogleGemini
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 4. GOOGLE EARTH ENGINE (GEE) - INTEGRACIÓN SATELITAL BANDA C & OPTICA
# ------------------------------------------------------------------------------
# Configura una cuenta de servicio en Google Cloud Platform con rol Earth Engine Viewer:
GEE_SERVICE_ACCOUNT=agrotech-prod-service@tu-proyecto-gcp.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=/app/secrets/gee-private-key.json

# ------------------------------------------------------------------------------
# 5. COMUNICACIÓN ENTRE MICROSERVICIOS (RED PRIVADA DOCKER)
# ------------------------------------------------------------------------------
# En producción VPS con Docker Compose, los microservicios se comunican
# mediante sus nombres de host en la red 'agrotech-network':
SPATIAL_BACKEND_URL=http://agrotech-api:8000
STREAMLIT_DASHBOARD_URL=http://agrotech-dashboard:8501

# Si FastAPI corre en Render o un subdominio externo:
# SPATIAL_BACKEND_URL=https://api.agrotech.ve
