{
  "name": "agrotech-venezuela",
  "version": "1.0.0",
  "description": "Plataforma Integral de Inteligencia Edafo-Climática, Visión Satelital WebGIS 3 Niveles, Radar SAR Sentinel-1, Machine Learning Agronómico, Accesibilidad Rural Dual-Mode y Asesoría Gemini AI",
  "author": "Frank Sousa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/frankSousa23/agrotech-venezuela.git"
  },
  "keywords": [
    "agrotech",
    "webgis",
    "mapbiomas",
    "sentinel-1",
    "sentinel-2",
    "copernicus",
    "sar-radar",
    "gemini-ai",
    "iot",
    "esp32",
    "precision-agriculture",
    "venezuela",
    "nextjs",
    "fastapi",
    "streamlit"
  ],
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:frontend": "jest",
    "test:backend": "node scripts/run-backend-tests.js",
    "test:all": "jest && node scripts/run-backend-tests.js",
    "clean": "node -e \"fs.rmSync('.next', { recursive: true, force: true })\"",
    "postinstall": "prisma generate",
    "lint": "eslint"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@prisma/client": "^5.11.0",
    "d3": "^7.9.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.34.0",
    "mermaid": "^11.17.2",
    "next": "16.2.10",
    "papaparse": "^5.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "swagger-ui-react": "^5.32.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/d3": "^7.4.3",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-ui-react": "^5.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^30.4.2",
    "node-mocks-http": "^1.17.2",
    "prisma": "^5.11.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
