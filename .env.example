# ==============================================================================
# AGROTECH VENEZUELA — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# 💡 MODO EVALUACIÓN LOCAL TURNKEY (CERO FRICCIÓN):
# No es obligatorio configurar ninguna variable ni iniciar PostgreSQL para probar
# el sistema localmente. La plataforma detecta automáticamente la ausencia de
# credenciales y activa el modo sandbox en memoria con semillas de suelos venezolanos,
# series temporales calibradas y fallbacks agronómicos deterministas.
# ==============================================================================

# 1. Base de Datos Relacional PostgreSQL 15 (Opcional en desarrollo - Fallback a memoria)
POSTGRES_USER=agrotech_user
POSTGRES_PASSWORD=agrotech_secret_2026
POSTGRES_DB=agrotech_db
DATABASE_URL="postgresql://agrotech_user:agrotech_secret_2026@localhost:5444/agrotech_db?schema=public"

# 2. Seguridad y Tokens JWT
NEXTAUTH_SECRET=genera_un_secreto_seguro_con_openssl_rand_hex_32
NEXTAUTH_URL=http://localhost:3000

# 3. Google Gemini AI API (Opcional - Fallback a Motor Agronómico Local Experto)
# Obtén tu clave en https://aistudio.google.com
GEMINI_API_KEY=AIzaSy...
GOOGLE_API_KEY=AIzaSy...

# 4. Google Earth Engine & MapBiomas (Opcional - Fallback a Trayectorias Ecorregionales)
GEE_SERVICE_ACCOUNT=agrotech-gee@tu-proyecto.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=/ruta/a/tu/private-key.json

# 5. URLs de Microservicios Internos
SPATIAL_BACKEND_URL=http://localhost:8000
