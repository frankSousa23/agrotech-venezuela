// Prisma Schema for Agrotech Venezuela
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FARMER
  AGRONOMIST
  ADMIN
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  name         String
  passwordHash String          @default("demo_hash")
  role         Role            @default(FARMER)
  phone        String?
  stateId      String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  parcels      Parcel[]
  fieldLogs    FieldLog[]
  harvests     HarvestRecord[]
}

model Parcel {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  stateId        String
  municipalityId String
  areaHectares   Float
  polygonGeoJson String          // GeoJSON Polygon string
  centerLat      Float
  centerLng      Float
  currentCrop    String?
  soilTexture    String?
  ph             Float?
  organicMatter  Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  fieldLogs      FieldLog[]
  harvests       HarvestRecord[]
}

model FieldLog {
  id          String   @id @default(uuid())
  parcelId    String
  parcel      Parcel   @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logType     String   // SIEMBRA, ENCALADO, FERTILIZACION, RIEGO, FITOSANITARIO, OBSERVACION
  title       String
  description String
  dosage      String?
  date        DateTime @default(now())
}

model HarvestRecord {
  id             String   @id @default(uuid())
  parcelId       String
  parcel         Parcel   @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cropName       String
  sowingDate     DateTime
  harvestDate    DateTime
  yieldTonHa     Float
  predictedTonHa Float?
  notes          String?
  createdAt      DateTime @default(now())
}

model Crop {
  id             String   @id @default(uuid())
  name           String   @unique
  scientificName String
  description    String?
  idealPhMin     Float
  idealPhMax     Float
  waterReq       String
  createdAt      DateTime @default(now())
}

model Soil {
  id            String   @id @default(uuid())
  state         String
  locationName  String
  latitude      Float
  longitude     Float
  ph            Float
  organicMatter Float
  texture       String
  analysisDate  DateTime @default(now())
}

model Recommendation {
  id              String   @id @default(uuid())
  cropName        String
  soilTexture     String
  minPh           Float
  maxPh           Float
  limingRequired  Boolean  @default(false)
  limingDoseTonHa Float    @default(0.0)
  recommendation  String
}

